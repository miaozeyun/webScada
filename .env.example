# ============================================================
# webScada 环境变量模板 —— 复制为 .env 后按需修改
#   cp .env.example .env
# 密钥生成（二选一 shell）：
#   JWT_SECRET：       python -c "import secrets;print(secrets.token_hex(32))"
#   DATASOURCE_SECRET：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=webscada
POSTGRES_PASSWORD=webscada123
POSTGRES_DB=webscada

# ---- 鉴权 ----
# JWT 签名密钥（必填，部署前务必更换）
JWT_SECRET=
# JWT 有效期（小时），默认 2
# JWT_EXPIRE_HOURS=2
# 登录失败锁定：5 次失败锁 60 秒（内存计数）
# LOGIN_LOCKOUT_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=60

# ---- 数据源凭证加密（G6，必填）----
# Fernet 密钥：库内加密 MQTT/REST/WS 凭证，丢失 = 已存凭证不可解，需重填
DATASOURCE_SECRET=

# ---- 管理员初始化（无注册接口，单团队）----
ADMIN_USER=admin
# 必填：仅在用户不存在时创建（幂等，不覆盖已改密码）
# 演示平台默认 123456；正式部署务必覆盖为强密码
ADMIN_PASSWORD=123456

# ---- 对外端口 ----
HTTP_PORT=80
# 对外可访问地址（分享链接用）：反代/域名/非 80 端口部署时必填，如 https://scada.example.com:8088
# 留空 = 按请求 Host 推导（nginx 已传 $http_host，保留端口）
PUBLIC_BASE_URL=

# ---- 镜像与依赖加速（国内环境默认开启；海外环境改回官方值即可）----
# 基础镜像 registry 前缀（尾部含 /）：compose 的 image 与 Dockerfile FROM 共用。
#   国内：m.daocloud.io/docker.io/（或 dockerpull.com/）
#   官方：docker.io/
REG_PREFIX=m.daocloud.io/docker.io/
# pip 源（经 build-args 注入 server 镜像构建层）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 报警保留策略（G15；清理任务 M5 生效，参数先入基线）----
# ALARM_RETENTION_DAYS=30
# ALARM_MAX_ROWS_PER_PROJECT=200000

# ---- 公开面限流（G16；WS 限流 M4/M6 生效，参数先入基线）----
# SHARE_MAX_WS_PER_TOKEN=20
# JWT_WS_MAX_PER_USER_PROJECT=10
# RATE_LIMIT_CONNECT_PER_MIN=30
# WS_MAX_CONNECTIONS=50

# ---- 图片上传（编辑器图片/轮播组件直传；落盘 uploads_data 命名卷）----
# 单图上限（字节），与 nginx client_max_body_size 10m 同口径内
# UPLOAD_MAX_BYTES=5242880

# ---- EMQX ----
# 管理台仅内网访问（compose 未对宿主机发布 18083；如需访问可自行加 ports）
# EMQX_DASHBOARD_USER=admin
# EMQX_DASHBOARD_PASSWORD=public12345
# EMQX 首次启动自动创建的 MQTT 账号（生产务必覆盖）。
# 注意：服务端不会自动取用；工程的数据源面板里要填同一个账号/密码，否则采集被拒。
# EMQX_DEFAULT_USERNAME=webscada_mqtt
# EMQX_DEFAULT_PASSWORD=webscada_mqtt123

# ---- TLS 说明 ----
# nginx 同时发布 80（HTTP_PORT）与 443（HTTPS_PORT）：证书放 deploy/certs（首次启动 tls-init
# 自动生成自签，生产替换为企业 CA / Let's Encrypt）。token 走查询串的 WS 通道依赖 HTTPS。

# ---- 官网静态站（website/，与产品共用 80/443 按域名分流）----
# 官网域名，多个用空格分隔（如 "www.example.com example.com"）；留空 = 官网块不生效。
# 不能与产品访问域名相同：精确域名会抢走产品站的请求。
# SITE_DOMAIN=www.example.com
# 官网证书文件名（位于 deploy/certs/）。留空则复用自签 any——浏览器会告警。
# 正式上线：域名证书放 deploy/certs/ 后填文件名，然后 docker compose up -d nginx
# SITE_CERT=site.crt
# SITE_KEY=site.key

# ============================================================
# M8 服务端闭环新增（契约：docs/implementation/server-closed-loop-plan.md）
# ============================================================

# ---- 工程 JSON 契约版本（冻结规约见契约 §7）----
# CURRENT_SCHEMA_VERSION=1
# 服务端 N-1 兼容窗口深度（=1 表示接受 schemaVersion=N 与 N-1）
# SCHEMA_COMPAT_WINDOW=1

# ---- 服务端采集 / WS ----
# COLLECTOR_RECONNECT_MIN_MS=1000
# COLLECTOR_RECONNECT_MAX_MS=30000
# COLLECTOR_CONNECT_TIMEOUT_MS=5000
# WS_FRAME_COALESCE_MS=100
# 载荷时间戳偏差上限（超出回落服务端当前时间，防上游未对时/retained 旧消息）
# FRAME_TS_MAX_SKEW_MS=300000
# 通讯中断判定：最短静默窗 / 长连接阈值 / OPC UA 阈值
# COMM_TIMEOUT_MIN_MS=15000
# COMM_TIMEOUT_CONN_MS=90000
# COMM_TIMEOUT_OPCUA_MS=30000

# ---- 历史入库与保留（historian 清理任务消费）----
# HISTORY_RETENTION_DAYS=30
# HISTORY_SAMPLE_INTERVAL_MS=5000
# HISTORY_WRITE_BATCH=500

# ---- 报警外发通知（两项都为空 = 外发禁用；至少配一项用于 7x24 报警触达）----
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TIMEOUT_MS=5000
# NOTIFY_SMTP_HOST=
# NOTIFY_SMTP_PORT=465
# NOTIFY_SMTP_USERNAME=
# NOTIFY_SMTP_PASSWORD=
# NOTIFY_SMTP_FROM=
# NOTIFY_SMTP_USE_TLS=true
# ALARM_NOTIFY_MIN_LEVEL=warn
# ALARM_NOTIFY_THROTTLE_SEC=300

# ---- 限流（真实消费；RATE_LIMIT_ENABLED 仅压测时关闭）----
# RATE_LIMIT_ENABLED=true
# REST_LOGIN_PER_MIN=10
# REST_DATASOURCE_TEST_PER_MIN=12

# ---- 可观测 / CORS ----
# METRICS_TOKEN=            # 空=/metrics 免鉴权（生产建议设置或反代屏蔽该路径）

# ---- License（可选：留空 = 开源核心模式，全功能；配置后按授权收敛规模上限） ----
# LICENSE_KEY=            # python -m app.core.license issue 签发
# LICENSE_SIGNING_SECRET= # 签发方与产品侧共用的 HMAC 密钥（留空 = license 功能关闭）
# CORS_ORIGINS=             # 逗号分隔白名单；空=同源部署不放开 CORS
